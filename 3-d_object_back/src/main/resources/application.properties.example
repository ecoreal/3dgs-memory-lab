# ==========================================
#           3D Object Backend Config
# ==========================================
#
# 复制本文件为 application.properties 并填入真实值：
#   cp application.properties.example application.properties
# application.properties 已被 .gitignore 忽略，请勿提交真实密钥。

# ---- 服务端口 ----
server.port=80

# ---- 数据库配置 ----
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://<DB_HOST>:<DB_PORT>/<DB_NAME>?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
spring.datasource.username=<DB_USERNAME>
spring.datasource.password=<DB_PASSWORD>

# ---- JPA 配置 ----
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# ---- HTTP 响应压缩 ----
server.compression.enabled=true
server.compression.min-response-size=1024
server.compression.mime-types=application/json,application/xml,text/html,text/plain,text/css,text/javascript,application/javascript

# ---- 文件上传限制 ----
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# ---- JWT 双 Token 配置 ----
app.jwt.secret=<YOUR_JWT_SECRET_AT_LEAST_32_CHARS>
app.jwt.access-token-ttl=900000
app.jwt.refresh-token-ttl=1296000000

# ---- 应用访问地址（用于拼接文件 URL）----
app.base-url=http://localhost:${server.port}

# ---- AI 服务代理配置 ----
# 运行时通过环境变量 3D_OBJECT_RUN_ENV 决定使用哪个 IP：
# 1. 3D_OBJECT_RUN_ENV=SERVER 时优先使用 app.ai.server-ip
# 2. 未设置或不是 SERVER 时，优先使用 app.ai.local-ip；为空则自动探测本机 IPv4
app.ai.scheme=http
app.ai.port=8000
app.ai.server-ip=
app.ai.local-ip=127.0.0.1

# ---- 激活本地配置覆盖 ----
spring.profiles.active=local
