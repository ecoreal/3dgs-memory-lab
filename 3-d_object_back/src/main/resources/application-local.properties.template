# ==========================================
#   本地配置模板 (Local Override Template)
# ==========================================
# 使用方法:
#   1. 复制此文件并重命名为 application-local.properties
#   2. 修改下面的值为你自己的本地配置
#   3. application-local.properties 已被 .gitignore 忽略，不会提交到仓库
#
# 此文件中的配置会覆盖 application.properties 中的同名配置

# ---- 数据库配置 ----
spring.datasource.url=jdbc:mysql://localhost:3306/object_3d?serverTimezone=GMT%2B8&useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=123456

# ---- JWT 密钥 ----
app.jwt.secret=change-this-to-your-own-secret-key-at-least-32-chars

# ---- 服务端口（可选）----
# server.port=8080

# ---- 应用访问地址（部署时修改为实际域名）----
# app.base-url=https://your-domain.com

# ---- AI 服务代理配置（可选）----
# 运行时会解析环境变量 3D_OBJECT_RUN_ENV
# - 若值为 SERVER，则优先使用 app.ai.server-ip
# - 否则优先使用 app.ai.local-ip；未配置时自动探测本机 IPv4
# app.ai.scheme=http
# app.ai.port=8000
# app.ai.server-ip=your-server-ip
# app.ai.local-ip=127.0.0.1
